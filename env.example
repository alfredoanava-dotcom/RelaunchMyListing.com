# ------------------------------------------------------------------
# Copy this to ".env" for LOCAL testing, and set the SAME values in
# Hostinger (hPanel > your Node app > Environment Variables) for the
# LIVE site. Never commit the real .env — it holds a password.
#
# This works exactly like azhomelistings.net: Gmail + App Password.
# The ONLY value you must set is GMAIL_APP_PASSWORD.
# ------------------------------------------------------------------

# 16-char Gmail App Password (NOT your normal Gmail login password).
# You can reuse the same one from azhomelistings.net.
# Get one: myaccount.google.com > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your16charAppPassword

# --- everything below is OPTIONAL; these defaults already work ---

# The Gmail account that sends the alerts.
GMAIL_USER=Alfredo.anava@gmail.com

# Where your readable lead alerts land.
LEAD_TO=Alfredo.anava@gmail.com

# Your Lofty email-parsing address (auto-creates the lead in Lofty).
LOFTY_PARSING_EMAIL=alfredo_nava@mail.lofty.me

# Set automatically by Hostinger; leave alone locally.
PORT=3000
